# PostgreSQL Database Configuration (Async with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Groq LLM API Key (used for contextual security analysis and specification testing)
GROQ_API_KEY=

# Google OAuth Configuration (Backend-Only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT Security Configuration
JWT_SECRET_KEY=sceptic-super-secret-dev-jwt-key-32-chars-long!

# Environment
ENVIRONMENT=development
