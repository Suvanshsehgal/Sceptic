# ========================================================
# Database Configuration
# ========================================================
# Option A: Local Docker PostgreSQL (Default in docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://sceptic:sceptic_password_dev@localhost:5432/sceptic
#
# Option B: External PostgreSQL / Supabase
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Local Docker Postgres Service Settings
POSTGRES_USER=sceptic
POSTGRES_PASSWORD=sceptic_password_dev
POSTGRES_DB=sceptic
POSTGRES_PORT=5432

# ========================================================
# Redis & Celery
# ========================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ========================================================
# Service Ports
# ========================================================
BACKEND_PORT=8000
FRONTEND_PORT=5173
TARGET_SERVICE_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ========================================================
# Target Service Deployment Metadata
# ========================================================
APPLICATION_VERSION=1.0.0
COMMIT_SHA=dev-local
BUILD_TIMESTAMP=2026-10-07T00:00:00Z
ENVIRONMENT=development

# ========================================================
# AI / LLM Configuration
# ========================================================
# Groq LLM API Key (used for contextual security analysis and feature scoping)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ========================================================
# Authentication & Security
# ========================================================
# Google OAuth Configuration (Backend-Only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT Security Configuration
JWT_SECRET_KEY=sceptic-super-secret-dev-jwt-key-32-chars-long!

