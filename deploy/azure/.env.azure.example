# Copy to deploy/azure/.env on the VM and fill every value. Never commit the real .env.
# Generate random secrets with:  openssl rand -hex 32

# Public name of the VM (Azure gives each public IP a free name: <label>.<region>.cloudapp.azure.com)
SCEPTIC_DOMAIN=sceptic-yourname.centralindia.cloudapp.azure.com

POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=change-me-at-least-32-characters
GITHUB_WEBHOOK_SECRET=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Group id of the docker group on the VM:  getent group docker | cut -d: -f3
DOCKER_GID=999

# Optional: model features (the platform runs without it, with deterministic checks only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: tracing (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional: command that switches the target service during a rollback (rollbacks are recorded as FAILED without it)
ROLLBACK_COMMAND=

# Release identity shown by the target service
APPLICATION_VERSION=1.0.0
COMMIT_SHA=azure-release
